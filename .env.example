# Neon: Dashboard -> Connect -> "Pooled connection" manzilini qo'ying
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Birinchi ishga tushirishda yaratiladigan foydalanuvchilar parollari (ishlab chiqarishda majburiy)
ADMIN_PASSWORD=
SELLER_PASSWORD=
# Ixtiyoriy: soatlik tahlil vaqt mintaqasi (standart Asia/Tashkent), lokal port
TZ_NAME=Asia/Tashkent
PORT=3000
